          "ranking_truncated": false,
          "row_count": 50,
          "evidence": {
            "sql": "WITH analytical_result AS (WITH grouped AS (\n            SELECT UPPER(TRIM(CAST(`region` AS STRING))) AS segment, UPPER(TRIM(CAST(`categoria` AS STRING))) AS dimension, SUM(`inv_neta_usd`) AS value,\n                   MIN(DATE(fecha)) AS _observed_start, MAX(DATE(fecha)) AS _observed_end\n            FROM `nexuslatam-master.NEXUS_GROUPM_BI_2.tb_data_bicompetitive` WHERE DATE(`fecha`) >= @start_date AND DATE(`fecha`) <= @end_date GROUP BY segment, dimension\n        ), scored AS (\n            SELECT *, SUM(value) OVER (PARTITION BY segment) AS group_total,\n                   DENSE_RANK() OVER (PARTITION BY segment ORDER BY value DESC) AS rank,\n                   MIN(_observed_start) OVER () AS _scope_start,\n                   MAX(_observed_end) OVER () AS _scope_end\n            FROM grouped WHERE value IS NOT NULL\n        )\n        SELECT segment, dimension, value, group_total, rank,\n               SAFE_DIVIDE(value, group_total) * 100 AS share_pct,\n               _scope_start AS _observed_start, _scope_end AS _observed_end,\n               COUNT(*) OVER () AS ranked_rows_total\n        FROM scored WHERE rank <= @limit\n        ORDER BY CAST(segment AS STRING), rank, CAST(dimension AS STRING)\n        LIMIT 500), source_coverage AS (SELECT MIN(DATE(`fecha`)) AS _available_start, MAX(DATE(`fecha`)) AS _available_end FROM `nexuslatam-master.NEXUS_GROUPM_BI_2.tb_data_bicompetitive`) SELECT analytical_result.*, source_coverage.* FROM analytical_result CROSS JOIN source_coverage",
